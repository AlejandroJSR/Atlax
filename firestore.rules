rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Notas personales ----
    match /notas/{userId}/clases/{claseId} {
      allow read, write: if request.auth.uid == userId;
    }

    // ---- Cursos (públicos) ----
    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if request.auth != null; // solo autenticados
    }

    // ---- Compras (temporal: todos los logueados pueden leer y escribir) ----
    match /compras/{compraId} {
      allow read, write: if request.auth != null;
    }

    // ---- Usuarios ----
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || request.auth.token.admin == true;
    }
  }
}

